CCTV_APP_ENV=development
CCTV_APP_MODE=dry_run
CCTV_AI_DEVICE=cpu
# When CUDA is requested, false fails fast instead of silently using CPU.
CCTV_AI_ALLOW_CPU_FALLBACK=false
CCTV_AI_CUDA_DEVICE_ID=0
# Optional per-process ONNX Runtime arena limit. This does not prevent model duplication.
CCTV_AI_CUDA_GPU_MEM_LIMIT_MB=
CCTV_ANALYSIS_FPS=2
CCTV_DETECTOR_ENABLED=false
CCTV_DETECTOR_TYPE=yolo_onnx
CCTV_DETECTOR_INPUT_SIZE=640
CCTV_DETECTOR_CONFIDENCE_THRESHOLD=0.25
CCTV_DETECTOR_NMS_THRESHOLD=0.45
CCTV_DETECTION_CLASS_NAMES=person,car,cat,dog
# Deprecated compatibility switch; prefer CCTV_DETECTOR_ENABLED.
CCTV_YOLO_ENABLED=false
CCTV_YOLO_INPUT_SIZE=640
CCTV_YOLO_CONFIDENCE_THRESHOLD=0.25
CCTV_YOLO_NMS_THRESHOLD=0.45
CCTV_TRACKING_ENABLED=true
CCTV_TRACKER_CLASS_NAMES=person
CCTV_TRACKER_IOU_THRESHOLD=0.3
CCTV_TRACKER_MAX_MISSED_FRAMES=10
CCTV_TRACKER_MAX_IDLE_SECONDS=12
CCTV_PERSIST_DETECTIONS=true
# all | detections | events; event/action frames are always saved atomically.
CCTV_FRAME_PERSISTENCE_MODE=all
CCTV_RULES_ENABLED=true
CCTV_ANALYSIS_SUPERVISOR_ENABLED=true
CCTV_ANALYSIS_SUPERVISOR_RECONCILE_INTERVAL_SECONDS=5
CCTV_ANALYSIS_SUPERVISOR_MAX_WORKERS=2
CCTV_ANALYSIS_SUPERVISOR_RESTART_BASE_SECONDS=2
CCTV_ANALYSIS_SUPERVISOR_RESTART_MAX_SECONDS=60
CCTV_ANALYSIS_SUPERVISOR_SHUTDOWN_TIMEOUT_SECONDS=10
CCTV_ANALYSIS_SUPERVISOR_LEASE_SECONDS=20
CCTV_HIPERWALL_DRY_RUN_ENABLED=true
# Only the backend service executes queued LIVE actions. Analysis workers only enqueue them.
CCTV_HIPERWALL_EXECUTOR_ENABLED=true
CCTV_HOST=127.0.0.1
CCTV_PORT=8000
CCTV_LOG_LEVEL=INFO
CCTV_LOG_PATH=./runtime/logs/cctv.jsonl
CCTV_LOG_MAX_BYTES=10485760
CCTV_LOG_BACKUP_COUNT=5
CCTV_DATABASE_PATH=./runtime/cctv.db
CCTV_MODEL_PATH=./artifacts/models/model.onnx
CCTV_MODEL_CLASSES_PATH=
CCTV_LOCAL_VIDEO_PATH=../video/testvideo1.mp4
CCTV_SNAPSHOT_DIR=./runtime/snapshots
CCTV_SNAPSHOT_JPEG_QUALITY=90
CCTV_IDENTITY_PHOTO_DIR=./runtime/identity_images
CCTV_FACE_DETECTION_MODEL_PATH=./artifacts/models/face/face_detection_yunet_2026may.onnx
CCTV_FACE_EMBEDDING_MODEL_PATH=./artifacts/models/face/face_recognition_sface_2021dec.onnx
CCTV_FACE_DETECTION_SCORE_THRESHOLD=0.8
CCTV_FACE_DETECTION_NMS_THRESHOLD=0.3
CCTV_FACE_DETECTION_TOP_K=5000
CCTV_FACE_DETECTION_MAX_INPUT_DIMENSION=960
CCTV_FACE_MATCHING_ENABLED=false
CCTV_FACE_MATCH_SIMILARITY_THRESHOLD=0.45
CCTV_FACE_MATCH_MINIMUM_MARGIN=0.05
CCTV_FACE_MATCH_UNKNOWN_RETRY_SECONDS=2
CCTV_FACE_IDENTITY_STITCH_MAX_GAP_SECONDS=12
CCTV_FACE_IDENTITY_STITCH_MIN_SIMILARITY=0.35
CCTV_FACE_IDENTITY_STITCH_MAX_DISTANCE_RATIO=6
CCTV_TEST_DASHBOARD_ENABLED=true
CCTV_MEDIA_HLS_BASE_URL=http://127.0.0.1:18888
CCTV_MEDIAMTX_DYNAMIC_PATHS_ENABLED=true
CCTV_MEDIAMTX_API_TIMEOUT_SECONDS=5
CCTV_MEDIAMTX_RECONCILE_INTERVAL_SECONDS=10
# Optional Fernet key override. Empty uses runtime/secrets/camera_credentials.key.
CCTV_CAMERA_CREDENTIAL_KEY=
CCTV_RTSP_INPUT_URL=
CCTV_RTSP_WORKER_URL=rtsp://127.0.0.1:8554/camera
CCTV_RTSP_SOURCE_NAME=camera
CCTV_RTSP_OPEN_TIMEOUT_SECONDS=10
CCTV_RTSP_READ_TIMEOUT_SECONDS=10
CCTV_RTSP_RECONNECT_INITIAL_SECONDS=1
CCTV_RTSP_RECONNECT_MAX_SECONDS=30
CCTV_RTSP_RECONNECT_JITTER_RATIO=0.2
CCTV_RTSP_MAX_RETRIES=20
CCTV_RESTREAM_URL=rtsp://127.0.0.1:8554/analyzed
LOCAL_VIDEO_DIR=../video
LOCAL_VIDEO_FILE=testvideo1.mp4
LOCAL_VIDEO_MAX_SAMPLES=10
RTSP_TEST_VIDEO_DIR=../video
RTSP_TEST_VIDEO_FILE=testvideo1.mp4
HIPERWALL_BASE_URL=http://hiperwall-host:8000
HIPERWALL_AUTH_MODE=none
HIPERWALL_USER=
HIPERWALL_TOKEN=
HIPERWALL_TIMEOUT_SECONDS=3
HIPERWALL_POLL_INTERVAL_SECONDS=0.5
HIPERWALL_MAX_ATTEMPTS=8
HIPERWALL_RETRY_BASE_SECONDS=5
HIPERWALL_RETRY_MAX_SECONDS=300
HIPERWALL_DEFAULT_DISPLAY_SECONDS=30
